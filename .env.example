# PostgreSQL connection string used by the backend service
DATABASE_URL=postgresql://username:password@localhost:5432/pollen_forecast

# Development only. Staging and production require explicit HTTPS origins and
# keep all external pollen fetches disabled unless explicitly enabled.
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EXTERNAL_POLLEN_FETCH_ENABLED=true
POLLEN_PROVIDER_WEATHERDT_ENABLED=true
POLLEN_PROVIDER_BEIJING_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
LOG_LEVEL=info
